{
  "name": "@recount/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc -p .",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "revenue": "tsx --env-file-if-exists=../../.env src/revenue/cli.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@hono/node-server": "^2.1.4",
    "@recount/semantic": "workspace:^",
    "@recount/shared": "workspace:^",
    "@recount/sites": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "isbot": "^5.2.2",
    "postgres": "^3.4.9",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
