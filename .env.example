# API
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgres://recount:recount@localhost:5442/recount
CLICKHOUSE_URL=http://localhost:8133
CLICKHOUSE_USER=recount
CLICKHOUSE_PASSWORD=recount
CLICKHOUSE_DATABASE=recount
# Proves you own the server when creating the first account, and works as an all-access bearer
# token for scripts until they move to API keys (min 24 chars). Generate: openssl rand -hex 24
ADMIN_TOKEN=
# true only when Cloudflare proxies every request; otherwise visitors could forge their address.
TRUST_CF_HEADERS=false

# AI reading (optional). Without a key the dashboard lists detected changes without the prose.
ANTHROPIC_API_KEY=
READING_MODEL=claude-sonnet-5-5
REPLAY_MODEL=claude-haiku-5-5
# Session summaries per site per day; 0 turns the job off.
REPLAY_SUMMARIES_PER_DAY=50
